[Unit]
Description=Showcase Bot for the AI Uplift Slack
After=network-online.target

[Service]
WorkingDirectory=%h/work/slack-showcase-bot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/op-agent run --env-file %h/work/slack-showcase-bot/deploy/alejo/server.env.tpl -- %h/.local/bin/uv run --frozen python -m showcase.app
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
